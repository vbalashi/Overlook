{
  "info": {
    "name": "Overlook Agent API",
    "description": "Control a KVM device via the Overlook macOS app local HTTP API. Enable the server in Settings → Agent API, then copy your API key into the collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:9876",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "YOUR_API_KEY_HERE",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_key}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Status",
      "item": [
        {
          "name": "Get Connection Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/status",
              "host": ["{{base_url}}"],
              "path": ["status"]
            },
            "description": "Returns whether a KVM device is connected and its name."
          },
          "response": [
            {
              "name": "Connected",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"connected\": true,\n  \"device\": \"GL.iNet Comet\"\n}"
            },
            {
              "name": "Not Connected",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"connected\": false,\n  \"device\": null\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Keyboard",
      "item": [
        {
          "name": "Type Text",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hello, World!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/type",
              "host": ["{{base_url}}"],
              "path": ["type"]
            },
            "description": "Types a string of text on the remote machine using HID keyboard emulation. Supports multi-line text and Unicode."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"ok\": true\n}"
            }
          ]
        },
        {
          "name": "Type Username",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"admin\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/type",
              "host": ["{{base_url}}"],
              "path": ["type"]
            },
            "description": "Example: type a username into a login field."
          },
          "response": []
        },
        {
          "name": "Press Enter",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"Enter\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/key",
              "host": ["{{base_url}}"],
              "path": ["key"]
            },
            "description": "Sends a single key press. Key names are case-sensitive Web KeyboardEvent format: Enter, Escape, Tab, Backspace, Space, ArrowUp, ArrowDown, ArrowLeft, ArrowRight, F1–F12, KeyA–KeyZ, Digit0–Digit9."
          },
          "response": []
        },
        {
          "name": "Press Tab",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"Tab\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/key",
              "host": ["{{base_url}}"],
              "path": ["key"]
            },
            "description": "Sends Tab key — useful for moving between form fields."
          },
          "response": []
        },
        {
          "name": "Press Escape",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"Escape\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/key",
              "host": ["{{base_url}}"],
              "path": ["key"]
            },
            "description": "Sends the Escape key."
          },
          "response": []
        },
        {
          "name": "Send Ctrl+Alt+Del",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"ControlLeft+AltLeft+Delete\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/key",
              "host": ["{{base_url}}"],
              "path": ["key"]
            },
            "description": "Sends Ctrl+Alt+Delete — useful for Windows login screens."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Mouse",
      "item": [
        {
          "name": "Get Mouse Position",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/mouse/position",
              "host": ["{{base_url}}"],
              "path": ["mouse", "position"]
            },
            "description": "Returns the last known mouse position in HID absolute units (0–32767). Since KVM devices do not report cursor state back, this reflects the position from the most recent /mouse/move call. Defaults to center (16383, 16383) on startup."
          },
          "response": [
            {
              "name": "Position",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"x\": 16383,\n  \"y\": 16383\n}"
            }
          ]
        },
        {
          "name": "Move Mouse (Center)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"x\": 0,\n  \"y\": 0\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/mouse/move",
              "host": ["{{base_url}}"],
              "path": ["mouse", "move"]
            },
            "description": "Moves the mouse to an absolute position. Coordinates are signed HID units: range -32767 to +32767. (0,0) = center, (-32767,-32767) = top-left, (32767,32767) = bottom-right."
          },
          "response": []
        },
        {
          "name": "Move Mouse (Top-Left)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"x\": 0,\n  \"y\": 0\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/mouse/move",
              "host": ["{{base_url}}"],
              "path": ["mouse", "move"]
            },
            "description": "Move mouse to top-left corner of the remote screen."
          },
          "response": []
        },
        {
          "name": "Left Click",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"button\": \"left\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/mouse/click",
              "host": ["{{base_url}}"],
              "path": ["mouse", "click"]
            },
            "description": "Clicks the left mouse button at the current cursor position. Supported buttons: left, right, middle."
          },
          "response": []
        },
        {
          "name": "Right Click",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"button\": \"right\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/mouse/click",
              "host": ["{{base_url}}"],
              "path": ["mouse", "click"]
            },
            "description": "Clicks the right mouse button — opens context menus."
          },
          "response": []
        },
        {
          "name": "Scroll Down",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deltaX\": 0,\n  \"deltaY\": -3\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/mouse/scroll",
              "host": ["{{base_url}}"],
              "path": ["mouse", "scroll"]
            },
            "description": "Scrolls the mouse wheel. Positive deltaY = up, negative = down. Positive deltaX = right, negative = left."
          },
          "response": []
        },
        {
          "name": "Scroll Up",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deltaX\": 0,\n  \"deltaY\": 3\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/mouse/scroll",
              "host": ["{{base_url}}"],
              "path": ["mouse", "scroll"]
            },
            "description": "Scrolls up by 3 units."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Screen",
      "item": [
        {
          "name": "Take Screenshot",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/screenshot",
              "host": ["{{base_url}}"],
              "path": ["screenshot"]
            },
            "description": "Captures the live KVM video frame and returns a PNG image (falls back to Mac display if no frame is available). Use for visual feedback after performing actions."
          },
          "response": [
            {
              "name": "PNG Image",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "image/png" }],
              "body": ""
            }
          ]
        },
        {
          "name": "Find Text (OCR)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Login\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/find-text",
              "host": ["{{base_url}}"],
              "path": ["find-text"]
            },
            "description": "Runs OCR on the current KVM video frame and returns all regions whose text contains the search string (case-insensitive).\n\nHID coordinates (x, y, width, height): signed range -32767 (top-left) to +32767 (bottom-right), center = 0. Use x/y directly with /mouse/move.\n\nPixel coordinates (px, py, pw, ph): position within the video frame, same coordinate space as /screenshot.\n\nHID formula: x = (px / frame_width * 2 - 1) * 32767"
          },
          "response": [
            {
              "name": "Matches Found",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"matches\": [\n    {\n      \"text\": \"Login\",\n      \"x\": -3200,\n      \"y\": -10500,\n      \"confidence\": 0.98\n    }\n  ]\n}"
            },
            {
              "name": "No Matches",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"matches\": []\n}"
            },
            {
              "name": "No Video Frame",
              "status": "Service Unavailable",
              "code": 503,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"No video frame available\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Workflows",
      "item": [
        {
          "name": "Login Flow — Type Username",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"admin\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/type",
              "host": ["{{base_url}}"],
              "path": ["type"]
            },
            "description": "Step 1 of login: type the username. Follow with Tab → type password → Enter."
          },
          "response": []
        },
        {
          "name": "Login Flow — Tab to Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"Tab\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/key",
              "host": ["{{base_url}}"],
              "path": ["key"]
            },
            "description": "Step 2 of login: tab to the password field."
          },
          "response": []
        },
        {
          "name": "Login Flow — Type Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"my-secret-password\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/type",
              "host": ["{{base_url}}"],
              "path": ["type"]
            },
            "description": "Step 3 of login: type the password."
          },
          "response": []
        },
        {
          "name": "Login Flow — Submit",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"Enter\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/key",
              "host": ["{{base_url}}"],
              "path": ["key"]
            },
            "description": "Step 4 of login: press Enter to submit."
          },
          "response": []
        },
        {
          "name": "Login Flow — Verify Screenshot",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/screenshot",
              "host": ["{{base_url}}"],
              "path": ["screenshot"]
            },
            "description": "Step 5 of login: take a screenshot to verify the result."
          },
          "response": []
        }
      ]
    }
  ]
}
